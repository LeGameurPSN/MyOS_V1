#!/bin/bash
# psnos-oobe — Assistant de configuration au premier démarrage (façon Windows 11)
set -e

MARKER_DIR="$HOME/.config/psnos"
MARKER_FILE="$MARKER_DIR/oobe_done"
mkdir -p "$MARKER_DIR"

# Ne se relance pas si déjà fait
[ -f "$MARKER_FILE" ] && exit 0

TITLE="PSN_OS — Configuration initiale"

# 1. Langue
LANG_CHOICE=$(zenity --list --title="$TITLE" \
    --text="Choisissez votre langue / Choose your language" \
    --radiolist --column="" --column="Langue" \
    TRUE "Français" \
    FALSE "English" \
    --width=400 --height=250)

if [ "$LANG_CHOICE" = "English" ]; then
    export LANG_TAG="en_US.UTF-8"
else
    export LANG_TAG="fr_FR.UTF-8"
fi
sudo update-locale LANG="$LANG_TAG" 2>/dev/null || true

# 2. Wifi
zenity --question --title="$TITLE" \
    --text="Voulez-vous vous connecter au Wifi maintenant ?" \
    --width=350
if [ $? -eq 0 ]; then
    nmcli device wifi rescan 2>/dev/null || true
    NETWORKS=$(nmcli -t -f SSID device wifi list | awk 'NF' | sort -u)
    SSID=$(echo "$NETWORKS" | zenity --list --title="$TITLE" \
        --text="Sélectionnez un réseau Wifi" --column="Réseaux" --width=400 --height=350)
    if [ -n "$SSID" ]; then
        WIFI_PASS=$(zenity --password --title="$TITLE" --text="Mot de passe pour \"$SSID\"")
        nmcli device wifi connect "$SSID" password "$WIFI_PASS" || \
            zenity --error --text="Connexion impossible. Vous pourrez réessayer depuis l'icône réseau."
    fi
fi

# 3. Compte utilisateur (renommage / mot de passe si besoin)
FORM=$(zenity --forms --title="$TITLE" \
    --text="Personnalisez votre compte" \
    --add-entry="Nom d'affichage" \
    --add-password="Nouveau mot de passe (laisser vide pour ne pas changer)" \
    --width=400)
DISPLAY_NAME=$(echo "$FORM" | cut -d'|' -f1)
NEW_PASS=$(echo "$FORM" | cut -d'|' -f2)

if [ -n "$DISPLAY_NAME" ]; then
    sudo chfn -f "$DISPLAY_NAME" "$USER" 2>/dev/null || true
fi
if [ -n "$NEW_PASS" ]; then
    echo "$USER:$NEW_PASS" | sudo chpasswd 2>/dev/null || true
fi

# 4. Fuseau horaire
TZ_CHOICE=$(zenity --list --title="$TITLE" \
    --text="Choisissez votre fuseau horaire" \
    --column="Fuseau" \
    "Europe/Paris" "Europe/London" "America/New_York" "America/Los_Angeles" \
    "Asia/Tokyo" "Australia/Sydney" "UTC" \
    --width=400 --height=350)
[ -n "$TZ_CHOICE" ] && sudo timedatectl set-timezone "$TZ_CHOICE" 2>/dev/null || true

# 5. Thème
THEME_CHOICE=$(zenity --list --title="$TITLE" \
    --text="Choisissez un thème" \
    --radiolist --column="" --column="Thème" \
    TRUE "Clair" \
    FALSE "Sombre" \
    --width=350 --height=250)
if [ "$THEME_CHOICE" = "Sombre" ]; then
    xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita-dark" 2>/dev/null || true
else
    xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita" 2>/dev/null || true
fi

zenity --info --title="$TITLE" \
    --text="Configuration terminée. Bienvenue sur PSN_OS !" --width=350

touch "$MARKER_FILE"
